var musicaModel =require("../models/musicaModel");

function mostrar(req, res){
     musicaModel.mostrar().then(
        function (resultado) {
            if (resultado.length > 0) {
                res.json(resultado);
            } else {
                res.status(404).json({ error: "Nenhuma musica encontrada" });
            }
        }
    ).catch(
        function (erro) {
            console.log(erro);
            res.status(500).json({ error: "Erro ao buscar musica" });
        }
     )
}

function salvar(req, res){
    console.log(req.body);
    var idUsuario = req.body.idUsuario; 
    var idMusica = req.body.idMusica;
    console.log("ID do usuário: " + idUsuario);
    console.log("ID da música: " + idMusica);
    musicaModel.salvar(idUsuario, idMusica).then(
        function (resultado) {
            if (resultado.length > 0) {
                res.json(resultado);
            } else {
                res.status(404).json({ error: "Nenhuma musica encontrada" });
            }
        }
    ).catch(
        function (erro) {
            console.log(erro);
            res.status(500).json({ error: "Erro ao buscar musica" });
        }
    )
}

function curtidas(req, res){
    musicaModel.curtidas().then(
        function (resultado) {
            if (resultado.length > 0) {
                res.json(resultado);
            } else {
                res.status(404).json({ error: "Nenhuma musica curtida" });
            }
        }
    ).catch(
        function (erro) {
            console.log(erro);
            res.status(500).json({ error: "Erro ao buscar musica curtida" });
        }
    )
}

async function salvarUsuario(req, res) {
    const idUsuario = req.query.idUsuario;
    try {
        const resultado = await musicaModel.salvarUsuario(idUsuario);
        res.json(resultado.map(r => r.fkmusica)); 
    } catch (erro) {
        res.status(500).json({ error: "Erro ao buscar músicas curtidas do usuário" });
    }
}

module.exports = {
    mostrar,
    salvar,
    curtidas,
    salvarUsuario
}